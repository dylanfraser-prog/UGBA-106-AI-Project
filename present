<div id="nav">
  <button class="nav-btn" id="btn-prev" onclick="go(-1)">← Prev</button>
  <div class="nav-dots" id="dots"></div>
  <button class="nav-btn" id="btn-next" onclick="go(1)">Next →</button>
</div>

<script>
// ── BACKGROUND CANVAS ──────────────────────────────────
const bgc = document.getElementById('bg');
const bctx = bgc.getContext('2d');
let BW, BH;
function resizeBg() {
  BW = bgc.width = window.innerWidth;
  BH = bgc.height = window.innerHeight;
}
resizeBg(); window.addEventListener('resize', resizeBg);

const BLOBS = [
  {fx:.15, fy:.2, col:'rgba(255,77,90,', baseR:.35},
  {fx:.82, fy:.3, col:'rgba(0,221,184,', baseR:.3},
  {fx:.5,  fy:.8, col:'rgba(77,140,255,', baseR:.32},
  {fx:.5,  fy:.45,col:'rgba(167,139,250,', baseR:.22},
];
let btick = 0;
function drawBg() {
  requestAnimationFrame(drawBg);
  btick++;
  bctx.clearRect(0, 0, BW, BH);

  // Dot grid
  bctx.save();
  bctx.globalAlpha = .025;
  bctx.fillStyle = '#fff';
  const spacing = 36;
  for (let x = spacing/2; x < BW; x += spacing)
    for (let y = spacing/2; y < BH; y += spacing) {
      bctx.beginPath(); bctx.arc(x, y, .8, 0, Math.PI*2); bctx.fill();
    }
  bctx.restore();

  // Ambient blobs
  BLOBS.forEach((b, i) => {
    const pulse = 0.5 + 0.5 * Math.sin(btick * .012 + i * 1.4);
    const r = (b.baseR + pulse * .06) * BW;
    const gx = b.fx * BW, gy = b.fy * BH;
    const g = bctx.createRadialGradient(gx, gy, 0, gx, gy, r);
    g.addColorStop(0, b.col + (.04 + pulse * .03) + ')');
    g.addColorStop(1, b.col + '0)');
    bctx.save();
    bctx.fillStyle = g;
    bctx.fillRect(0, 0, BW, BH);
    bctx.restore();
  });

  // Subtle vignette
  const vig = bctx.createRadialGradient(BW/2, BH/2, BH*.2, BW/2, BH/2, BH*.85);
  vig.addColorStop(0, 'rgba(0,0,0,0)');
  vig.addColorStop(1, 'rgba(0,0,0,.55)');
  bctx.fillStyle = vig;
  bctx.fillRect(0, 0, BW, BH);
}
drawBg();

// ── SLIDE ENGINE ──────────────────────────────────────
const slides = Array.from(document.querySelectorAll('.slide'));
const TOTAL = slides.length;
let current = 0;

function buildDots() {
  const c = document.getElementById('dots');
  c.innerHTML = '';
  slides.forEach((_, i) => {
    const d = document.createElement('button');
    d.className = 'dot' + (i === 0 ? ' active' : '');
    d.onclick = () => goTo(i);
    c.appendChild(d);
  });
}
buildDots();

function updateUI() {
  document.getElementById('counter').textContent = `${String(current+1).padStart(2,'0')} / ${String(TOTAL).padStart(2,'0')}`;
  document.getElementById('progress').style.width = ((current/(TOTAL-1))*100) + '%';
  document.querySelectorAll('.dot').forEach((d,i) => d.classList.toggle('active', i===current));
  document.getElementById('btn-prev').style.opacity = current === 0 ? '.3' : '1';
  document.getElementById('btn-next').style.opacity = current === TOTAL-1 ? '.3' : '1';
}

function goTo(idx, dir) {
  if (idx < 0 || idx >= TOTAL || idx === current) return;
  const prev = slides[current];
  dir = dir ?? (idx > current ? 1 : -1);
  prev.classList.remove('active');
  prev.classList.add(dir > 0 ? 'exit-up' : 'exit-down');
  setTimeout(() => prev.classList.remove('exit-up','exit-down'), 600);
  current = idx;
  slides[current].classList.add('active');
  updateUI();
}

function go(dir) { goTo(current + dir, dir); }

updateUI();

// Keyboard
window.addEventListener('keydown', e => {
  if (e.key==='ArrowRight'||e.key==='ArrowDown'||e.key===' ') { e.preventDefault(); go(1); }
  if (e.key==='ArrowLeft' ||e.key==='ArrowUp')                 { e.preventDefault(); go(-1); }
});

// Touch / swipe
let touchX = null, touchY = null;
window.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; touchY = e.touches[0].clientY; }, {passive:true});
window.addEventListener('touchend', e => {
  if (touchX === null) return;
  const dx = e.changedTouches[0].clientX - touchX;
  const dy = e.changedTouches[0].clientY - touchY;
  if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
  else if (Math.abs(dy) > 40) go(dy < 0 ? 1 : -1);
  touchX = touchY = null;
}, {passive:true});

// Scroll wheel
let wheelLock = false;
window.addEventListener('wheel', e => {
  if (wheelLock) return;
  wheelLock = true;
  go(e.deltaY > 0 ? 1 : -1);
  setTimeout(() => wheelLock = false, 700);
}, {passive:true});
</script>
